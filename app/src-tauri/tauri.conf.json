{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bench",
  "version": "0.1.0",
  "identifier": "dev.bench.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bench",
        "width": 1120,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": { "installMode": "perMachine", "installerHooks": "./windows/hooks.nsh" }
    },
    "linux": {
      "deb": { "preRemoveScript": "./linux/prerm.sh" },
      "rpm": { "preRemoveScript": "./linux/prerm.sh" }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
